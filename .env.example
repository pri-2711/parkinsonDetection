# Flask binds to loopback by default. The backend keeps debug mode disabled.
HOST=127.0.0.1
PORT=5000
APP_SECRET_KEY=
LOG_LEVEL=INFO

# Selected tuned artifacts are separate from archive/Baseline_V1.
MODEL_ARTIFACT_DIR=experiments/regularized_svm_rf/results/artifacts
SPEECH_MODEL_FILE=speech_svm_tuned.joblib
HANDWRITING_MODEL_FILE=handwriting_svm_tuned.joblib

MAX_REQUEST_BYTES=23068672
AUDIO_MAX_BYTES=16777216
SPIRAL_MAX_BYTES=20971520
AUDIO_MIN_SECONDS=1
AUDIO_MAX_SECONDS=30
SPIRAL_MAX_SECONDS=30
SPIRAL_MAX_FRAMES=1200
SPIRAL_MAX_DIMENSION=4096
UPLOAD_TEMP_DIR=
SESSION_TTL_SECONDS=3600
TREMOR_ALLOWED_LOCATIONS=left_hand,right_hand,left_leg,right_leg,jaw,other
TREMOR_MAX_INTENSITY=10
